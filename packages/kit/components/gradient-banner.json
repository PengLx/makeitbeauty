{
  "id": "gradient-banner",
  "title": "Gradient banner",
  "description": "Full-bleed indigo→purple→slate gradient banner with kicker, title, subtitle and a cyan→fuchsia accent rule. The gradient is fixed by design: tw strings are static per definition (v1 constraint), so the slots are text-only.",
  "frame": { "w": 720, "h": 140 },
  "props": {
    "kicker": {
      "type": "string",
      "description": "Small uppercase eyebrow line above the title.",
      "default": "OPEN SOURCE · 2026"
    },
    "title": {
      "type": "string",
      "description": "Headline. Bind it, e.g. {{github.user.name}}.",
      "default": "Build in the open"
    },
    "subtitle": {
      "type": "string",
      "description": "Supporting line under the accent rule.",
      "default": "Designed with MakeItBeauty · rendered as pure SVG"
    }
  },
  "nodes": [
    {
      "id": "bg",
      "type": "rect",
      "x": 0, "y": 0, "w": 720, "h": 140,
      "tw": "bg-gradient-to-br from-indigo-950 via-purple-900 to-slate-900 rounded-xl border border-[rgba(255,255,255,0.14)] shadow-2xl"
    },
    {
      "id": "kicker",
      "type": "text",
      "x": 28, "y": 20, "w": 664, "h": 16,
      "text": "{{props.kicker}}",
      "tw": "text-cyan-300 font-semibold tracking-widest",
      "style": { "fontSize": 12 },
      "animation": { "preset": "slideUp", "durationMs": 600 }
    },
    {
      "id": "title",
      "type": "text",
      "x": 28, "y": 42, "w": 664, "h": 40,
      "text": "{{props.title}}",
      "tw": "text-white font-extrabold tracking-wide",
      "style": { "fontSize": 30 },
      "animation": { "preset": "slideUp", "durationMs": 600, "delayMs": 120 }
    },
    {
      "id": "rule",
      "type": "rect",
      "x": 28, "y": 92, "w": 180, "h": 4,
      "tw": "bg-gradient-to-r from-cyan-400 to-fuchsia-500 rounded-full",
      "animation": { "preset": "growX", "durationMs": 800, "delayMs": 280 }
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 28, "y": 106, "w": 664, "h": 18,
      "text": "{{props.subtitle}}",
      "tw": "text-slate-300 font-medium tracking-wider",
      "style": { "fontSize": 14 },
      "animation": { "preset": "slideUp", "durationMs": 600, "delayMs": 240 }
    }
  ]
}
