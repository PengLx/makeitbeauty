# MakeItBeauty configuration — copy to .env and fill in.
# All MIB_* vars from docs/architecture.md §4/§8. Consumed by the api service
# (docker-compose.yml env_file); MIB_WEB_PORT/MIB_RENDERER_ADDR are read by
# compose / the renderer as noted. Never commit a real .env.

# ---------------------------------------------------------------------------
# REQUIRED in production
# ---------------------------------------------------------------------------

# Deployment environment. "production" = no dev seed, no implicit user, auth
# must be configured, CORS locked to MIB_PUBLIC_URL, Secure cookies. Anything
# else behaves as dev.
MIB_ENV=production

# Public origin the deployment is reachable at (the domain attached to the
# web service). Used for OAuth redirects, CORS, and cookie scoping.
MIB_PUBLIC_URL=https://mib.example.com

# Master key for sealing connector credentials at rest (AES-256-GCM,
# architecture §9.1). Base64-encoded 32 bytes — generate with:
#   openssl rand -base64 32
# Production refuses to boot without it. Losing it means users must
# reconnect their connectors (projects are unaffected).
MIB_MASTER_KEY=

# GitHub App user login (architecture §8): create a GitHub App with
# identity-only permissions, callback URL ${MIB_PUBLIC_URL}/v1/auth/github/callback.
# Client ID + a generated client secret live on the App's settings page.
# See docs/deploy-coolify.md step 1.
MIB_GITHUB_CLIENT_ID=
MIB_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Reserved by the architecture (§8) — not read by the current build
# ---------------------------------------------------------------------------

# GitHub App slug (the app name in its github.com/apps/<slug> URL), for the
# install link once the editor surfaces it.
#MIB_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# Optional — sensible defaults for the compose deployment
# ---------------------------------------------------------------------------

# Persistence backend: "file" (durable JSON store, default) or "memory"
# (tests/throwaway runs — data lost on restart).
#MIB_STORE=file

# Where the file store keeps its data. The compose file pins this to /data
# (the mib-data named volume) — do not override in the container.
#MIB_DATA_DIR=/data

# API listen address inside the container (default :7800).
#MIB_ADDR=:7800

# Renderer base URL as seen from the api container. The compose file pins
# this to the internal service (http://renderer:7801).
#MIB_RENDERER_URL=http://renderer:7801

# Renderer listen address inside the renderer container (default :7801).
# Changing it requires matching MIB_RENDERER_URL and the healthchecks.
#MIB_RENDERER_ADDR=:7801

# GitHub endpoints used by the login flow — override only for GitHub
# Enterprise or tests.
#MIB_GITHUB_URL=https://github.com
#MIB_GITHUB_API_URL=https://api.github.com

# In-image asset paths, baked into the api image — only override when
# mounting custom kit components or fixtures.
#MIB_KIT_DIR=/app/packages/kit/components
#MIB_DEMO_DATA=/app/examples/demo-data.json
#MIB_DEMO_DESIGN=/app/examples/demo-design.json

# Host port the web service publishes (compose only, default 80). Set to a
# free port on hosts where 80 is taken (e.g. Coolify's proxy owns 80/443).
#MIB_WEB_PORT=80
